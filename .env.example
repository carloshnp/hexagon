# CIVITAS — Environment Variables
# Copy to .env and fill in your values

# Anthropic API Key (for Claude-powered report generation)
ANTHROPIC_API_KEY=

# OpenRouter API Key (alternative model provider)
OPENROUTER_API_KEY=

# Server settings
HOST=0.0.0.0
PORT=8000

# Data paths
ISP_DATA_PATH=/tmp/isp_data.csv
FAISS_INDEX_PATH=research/faiss/civitas_hnsw.index

# Vision settings
FACE_DETECTION_MIN_SIZE=40
BLUR_KSIZE=99
BLUR_SIGMA=30
